# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Mem0 Configuration (for persistent cross-session memory)
MEM0_ENABLED=true
MEM0_API_KEY="your-mem0-api-key"
MEM0_ORG_ID="your-mem0-org-id"
MEM0_PROJECT_ID="your-mem0-project-id"
# Maximum number of recent messages to keep in LangGraph checkpoint (older messages stored in mem0)
MEM0_CHECKPOINT_MESSAGE_LIMIT=10
# Maximum tokens to allocate for mem0 context in LLM calls
MEM0_CONTEXT_MAX_TOKENS=500

# Prompt Management Configuration (for Langfuse dynamic prompts)
# Default: matches APP_ENV (development/staging/production)
# Optional: override to use a different prompt label
# PROMPT_LABEL=staging
